<% content_for :title, @query ? %(Writing matching "#{@query}") : @tag ? "Writing tagged #{@tag.name}" : "Writing" %>
<%# Keeps search engines off result pages, which would only repeat the articles %>
<% content_for :head, tag.meta(name: "robots", content: "noindex") if @query %>

<section class="page-hero">
  <div class="site-wrap page-hero__split">
    <div class="page-hero__text">
      <p class="eyebrow">Writing</p>
      <% if @query %>
        <h1 class="page-title">Articles matching "<%= @query %>"</h1>
        <p class="lede"><%= link_to "← All writing", blog_path %></p>
      <% elsif @tag %>
        <h1 class="page-title">Articles tagged with "<%= @tag.name %>"</h1>
        <p class="lede"><%= link_to "← All writing", blog_path %></p>
      <% else %>
        <h1 class="page-title">Notes, now and then.</h1>
        <p class="lede">About work, what I'm reading and whatever else catches my attention. Some posts are in Portuguese.</p>
      <% end %>
    </div>
    <%= link_to blog_feed_path(format: :rss), class: "btn-site btn-site--primary" do %>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.2"/></svg>
      Subscribe via RSS
    <% end %>
  </div>
</section>

<div class="site-wrap blog-filters">
  <% if @topic_tags.any? %>
    <nav class="tag-filter" aria-label="Filter by topic">
      <ul class="chip-list">
        <li><%= link_to "All", blog_path, class: "chip", aria: { current: ("page" unless @tag || @query) } %></li>
        <% (@topic_tags.to_a | [ @tag ].compact).each do |topic| %>
          <li><%= link_to topic.name, blog_path(tag: topic.name), class: "chip", aria: { current: ("page" if topic == @tag && !@query) } %></li>
        <% end %>
      </ul>
    </nav>
  <% end %>
  <%= form_with url: blog_path, method: :get, class: "blog-search", role: "search", data: { controller: "blog-search" } do |form| %>
    <%= form.label :q, "Search writing", class: "visually-hidden" %>
    <svg class="blog-search__icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    <%= form.search_field :q, value: @query, placeholder: "Search", class: "blog-search__input", enterkeyhint: "search",
          data: { blog_search_target: "input", action: "input->blog-search#submitIfCleared" } %>
  <% end %>
</div>

<div class="site-wrap blog-layout">
  <div class="blog-layout__main">
    <% if @articles.any? %>
      <ol class="post-list">
        <% @articles.each do |article| %>
          <li class="post-list__item">
            <article>
              <%= render "header", article:, linked: true %>
              <% long = article.long? %>
              <div class="article-content post-entry__body<%= " post-entry__body--cut" if long %>">
                <%= article_body(article) %>
              </div>
              <% if long %>
                <%= link_to "Continue reading →", article_path(article.slug), class: "text-link post-entry__more", aria: { label: "Continue reading #{article.title}" } %>
              <% end %>
            </article>
          </li>
        <% end %>
      </ol>

      <% if @articles.total_pages > 1 %>
        <nav class="post-pagination" aria-label="Pagination">
          <span>Page <%= @articles.current_page %> of <%= @articles.total_pages %></span>
          <div class="btn-row">
            <%= link_to_prev_page @articles, "← Newer posts", class: "btn-site btn-site--outline" %>
            <%= link_to_next_page @articles, "Older posts →", class: "btn-site btn-site--outline" %>
          </div>
        </nav>
      <% end %>
    <% else %>
      <div class="empty-state">
        <p>No articles found.</p>
        <% if @tag || @query %>
          <%= link_to "← All writing", blog_path, class: "btn-site btn-site--outline" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= render "sidebar" %>
</div>
