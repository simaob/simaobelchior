<% if logged_in? %>
  <nav class="admin-bar" aria-label="Admin">
    <div class="site-wrap admin-bar__inner">
      <div class="admin-bar__links">
        <span class="admin-bar__label">Admin</span>
        <%= nav_link "Dashboard", admin_root_path, active: current_page?(admin_root_path) %>
        <%= nav_link "Articles", admin_articles_path, active: current_page?(admin_articles_path) %>
        <%= nav_link "New article", new_admin_article_path, active: current_page?(new_admin_article_path) %>
      </div>
      <%= button_to "Log out", logout_path, method: :delete, class: "btn-site btn-site--outline btn-site--sm" %>
    </div>
  </nav>
<% end %>
