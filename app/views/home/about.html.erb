<section class="page-hero">
  <div class="site-wrap">
    <p class="eyebrow">About</p>
    <h1 class="page-title">The longer story.</h1>
    <p class="lede">Software for the planet, for people, at scale. And now, with AI. The full CV lives on <a href="https://linkedin.com/in/simaobelchior">LinkedIn</a>; this is the why behind it.</p>
  </div>
</section>

<section class="site-wrap about-intro">
  <div class="about-intro__text">
    <p>I'm Simão Belchior, a software engineer from Porto. I studied Software Engineering at <a href="https://www.up.pt/feup/">FEUP</a>, started freelancing in 2008, and have spent the years since moving between writing code and leading the people who write it.</p>
    <p>Today I'm AI Lead at <a href="https://mindera.com">Mindera</a>, where I lead our AI horizontal: setting best practices for using generative AI across the product development lifecycle, and exploring its uses in applied AI.</p>
    <p class="about-intro__muted">Outside work I build <a href="https://kronflow.com">Kronflow</a>, <%= link_to "write here", blog_path %>, and spend as much time as I can with my family.</p>
  </div>
  <figure class="about-intro__figure">
    <%= image_tag "/images/porto_sunset_1600.jpg", alt: "Sunset over the Douro river in Porto, a gull flying over the water", width: 1600, height: 1200, loading: "lazy" %>
    <figcaption>Home: Porto, on the Douro.</figcaption>
  </figure>
</section>

<div class="site-wrap thread">
  <h2 class="section-title">The thread</h2>
  <p class="thread__intro">Five chapters, roughly in order.</p>
  <% chapters.each_with_index do |chapter, index| %>
    <section class="chapter" aria-labelledby="chapter-<%= index %>">
      <div class="chapter__head">
        <p class="chapter__num" aria-hidden="true"><%= format("%02d", index) %></p>
        <h3 id="chapter-<%= index %>" class="chapter__title"><%= chapter[:title] %></h3>
        <p class="chapter__lede"><%= chapter[:lede] %></p>
      </div>
      <div class="chapter__body">
        <ol class="stops">
          <% chapter[:stops].each do |stop| %>
            <li class="stop">
              <span class="stop__years"><%= stop[:years] %></span>
              <div class="stop__body">
                <p class="stop__org">
                  <%= stop[:url] ? link_to(stop[:org], stop[:url]) : stop[:org] %>
                  <span class="stop__role">· <%= stop[:role] %></span>
                </p>
                <p class="stop__what"><%= stop[:what] %></p>
              </div>
            </li>
          <% end %>
        </ol>
        <p class="chapter__lesson"><strong>What it taught me:</strong> [one sentence, in your own words]</p>
      </div>
    </section>
  <% end %>
</div>
