<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} - Simão Belchior" : "Simão Belchior - AI Lead at Mindera" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="author" content="Simão Belchior">
    <meta name="description" content="<%= content_for?(:description) ? content_for(:description) : "Software engineer from Porto who builds tools that help people do their work. Now AI Lead at Mindera and founder of Kronflow." %>">

    <!-- Facebook / Open Graph -->
    <meta property="og:title" content="<%= content_for?(:title) ? "#{content_for(:title)} - Simão Belchior" : "Simão Belchior - AI Lead at Mindera" %>">
    <meta property="og:description" content="<%= content_for?(:description) ? content_for(:description) : "Software engineer from Porto who builds tools that help people do their work. Now AI Lead at Mindera and founder of Kronflow." %>">
    <meta property="og:image" content="https://simaobelchior.com/images/porto_daylight_og.jpg">
    <meta property="og:type" content="<%= controller_path == "articles" && action_name == "show" ? "article" : "website" %>">
    <meta property="og:url" content="<%= request.original_url %>">

    <!-- Twitter -->
    <meta name="twitter:title" content="<%= content_for?(:title) ? "#{content_for(:title)} - Simão Belchior" : "Simão Belchior - AI Lead at Mindera" %>">
    <meta name="twitter:description" content="<%= content_for?(:description) ? content_for(:description) : "Software engineer from Porto who builds tools that help people do their work. Now AI Lead at Mindera and founder of Kronflow." %>">
    <meta name="twitter:image" content="https://simaobelchior.com/images/porto_daylight_og.jpg">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image:alt" content="Daytime view across the city to the Atlantic, under a blue sky with scattered clouds">
    <meta name="twitter:site" content="@belchior">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

		<!-- Global site tag (gtag.js) - Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-6EDTJ04NWD"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-6EDTJ04NWD');
		</script>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= auto_discovery_link_tag(:rss, blog_feed_path(format: :rss), title: "Simão Belchior - Blog RSS Feed") %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap">
    <%= stylesheet_link_tag "lexxy-content", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <%= render "shared/nav" %>
    <%= render "shared/admin_nav" if logged_in? && controller_path.start_with?("admin") %>
    <main class="flex-grow-1">
      <% if flash[:notice] %>
        <div class="site-wrap mt-3">
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= flash[:notice] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="site-wrap mt-3">
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= flash[:alert] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
