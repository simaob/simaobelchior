<% content_for :head, stylesheet_link_tag("lexxy-editor") %>

<%= form_with(model: [:admin, article], class: "needs-validation", local: true, data: { controller: "article-form" }) do |f| %>
  <% if article.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading">Please fix the following errors:</h4>
      <ul class="mb-0">
        <% article.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :title, class: "form-label" %>
    <%= f.text_field :title, class: "form-control", placeholder: "Enter article title", required: true, autofocus: true %>
  </div>

  <div class="mb-3">
    <%= f.label :slug, class: "form-label" %>
    <%= f.text_field :slug, class: "form-control", placeholder: "URL-friendly slug (auto-generated if blank)" %>
    <div class="form-text">Leave blank to auto-generate from title</div>
  </div>

  <div class="mb-3">
    <%= f.label :body, class: "form-label" %>
    <%= f.rich_text_area :body %>
  </div>

  <% existing_tags = Tag.by_usage.to_a %>
  <div class="mb-3" data-controller="tag-input" data-tag-input-tags-value="<%= existing_tags.map { |existing| { name: existing.name, count: existing.articles_count } }.to_json %>">
    <%= f.label :tag_list, "Tags", class: "form-label" %>
    <div class="position-relative">
      <%= f.text_field :tag_list, class: "form-control", placeholder: "ruby, rails, programming", autocomplete: "off",
            role: "combobox", aria: { autocomplete: "list", expanded: "false", controls: "tag-suggestions" },
            data: { tag_input_target: "input",
                    action: "input->tag-input#update keydown->tag-input#navigate keyup->tag-input#moveCaret click->tag-input#moveCaret blur->tag-input#leave" } %>
      <ul id="tag-suggestions" class="dropdown-menu w-100 top-100 start-0 mt-1" role="listbox" data-tag-input-target="suggestions" data-action="mousedown->tag-input#holdFocus"></ul>
    </div>
    <div class="form-text">Separate tags with commas</div>
    <div aria-live="polite">
      <div class="form-text text-warning-emphasis" data-tag-input-target="warnings" hidden></div>
    </div>

    <% if existing_tags.any? %>
      <div class="d-flex flex-wrap align-items-center gap-1 mt-2">
        <span class="form-text mt-0 me-1">Most used:</span>
        <% existing_tags.first(12).each do |existing| %>
          <button type="button" class="btn btn-sm btn-outline-primary" aria-pressed="false"
                  data-tag-input-target="chip" data-name="<%= existing.name %>" data-action="tag-input#toggle">
            <%= existing.name %> <span class="opacity-75"><%= existing.articles_count %></span>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :featured, class: "form-check-input" %>
    <%= f.label :featured, "Feature under \"Start here\" on the blog", class: "form-check-label" %>
  </div>

  <div class="mb-3">
    <%= f.label :published_at, class: "form-label" %>
    <%= f.datetime_local_field :published_at, class: "form-control", data: { article_form_target: "publishedAt" } %>
    <div class="form-text">Leave blank to save as draft. Time is in your local timezone.</div>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Save as Draft", name: "draft", class: "btn btn-secondary", data: { action: "click->article-form#saveAsDraft" } %>
    <%= f.submit article.persisted? ? "Update Article" : "Create Article", class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_articles_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
