<% content_for :title, "Edit #{@link.name_was}" %>
<div class="site-wrap my-4">
  <div class="mb-4">
    <%= link_to "← Back to the blogroll", admin_links_path, class: "text-decoration-none text-muted" %>
  </div>

  <div class="d-flex justify-content-between align-items-start mb-4">
    <h1 class="fw-semibold">Edit Link</h1>
    <%= button_to "Delete Link", admin_link_path(@link), method: :delete,
        data: { turbo_confirm: "Remove #{@link.name_was} from the blogroll?" },
        class: "btn btn-danger" %>
  </div>

  <%= render "form", link: @link %>
</div>
