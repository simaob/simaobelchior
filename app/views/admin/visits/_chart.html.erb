<%# Visits as bars, with page views in a lighter shade behind them. Locals: buckets
    (from VisitStats#buckets), title, and small: true for the shorter chart on the dashboard %>
<% ceiling = chart_ceiling(buckets.map(&:views).max) %>

<%= tag.div class: class_names("visits-chart", "visits-chart--small": local_assigns[:small], "visits-chart--dense": buckets.size > 60) do %>
  <div class="visits-chart__axis" aria-hidden="true">
    <span><%= number_with_delimiter(ceiling) %></span>
    <span>0</span>
  </div>
  <ol class="visits-chart__plot" aria-label="<%= title %>, <%= pluralize(buckets.size, buckets.first.unit.to_s) %>">
    <% buckets.each do |bucket| %>
      <li class="visits-chart__day" tabindex="0" aria-label="<%= bucket_label(bucket) %>: <%= pluralize(bucket.visits, "visit") %>, <%= pluralize(bucket.views, "page view") %>">
        <%# Every visit has at least one page view, so the visits bar fits inside the page views one %>
        <span class="visits-chart__views" style="height: <%= bar_height(bucket.views, ceiling) %>">
          <span class="visits-chart__bar" style="height: <%= bar_height(bucket.visits, [ bucket.views, 1 ].max) %>"></span>
          <span class="visits-chart__tip" aria-hidden="true">
            <strong><%= pluralize(number_with_delimiter(bucket.visits), "visit") %></strong>
            <%= pluralize(number_with_delimiter(bucket.views), "page view") %><br>
            <%= bucket_label(bucket) %>
          </span>
        </span>
      </li>
    <% end %>
  </ol>
  <div class="visits-chart__dates" aria-hidden="true">
    <span><%= bucket_axis_label(buckets.first) %></span>
    <span><%= bucket_axis_label(buckets.last, last: true) %></span>
  </div>
<% end %>
