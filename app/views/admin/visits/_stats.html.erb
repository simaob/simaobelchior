<%# Every visit stat in one PageView::Summary. Locals: summary, title, and link_base,
    which goes before each page path to link to it (blank for pages on this site) %>
<% totals = visit_totals(summary.days).merge("Page views, 30 days" => summary.days.sum(&:views)) %>

<div class="row">
  <% totals.each do |label, value| %>
    <div class="col-6 col-md-3 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <p class="text-muted text-uppercase small fw-semibold mb-2"><%= label %></p>
          <p class="h2 mb-0"><%= number_with_delimiter(value) %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="card border-0 shadow-sm mb-3">
  <div class="card-body">
    <h2 class="h6 fw-semibold mb-1">Visits per day</h2>
    <p class="small text-muted mb-4">Last 30 days. A visit is one person on one day, not counting bots or you while logged in.</p>

    <%= render "admin/visits/chart", days: summary.days, title: title %>

    <details class="mt-4">
      <summary class="small">Show as a table</summary>
      <table class="table table-sm small mt-2 mb-0 visits-table">
        <thead>
          <tr>
            <th scope="col">Day</th>
            <th scope="col" class="text-end">Visits</th>
            <th scope="col" class="text-end">Page views</th>
          </tr>
        </thead>
        <tbody>
          <% summary.days.reverse_each do |day| %>
            <tr>
              <td><%= day.day.strftime("%a %-d %b") %></td>
              <td class="text-end"><%= number_with_delimiter(day.visits) %></td>
              <td class="text-end"><%= number_with_delimiter(day.views) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </details>
  </div>
</div>

<div class="row">
  <div class="col-md-6 mb-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Top pages, last 30 days</h2>
        <% if summary.top_pages.any? %>
          <table class="table table-sm small mb-0 visits-table">
            <thead>
              <tr>
                <th scope="col">Page</th>
                <th scope="col" class="text-end">Page views</th>
              </tr>
            </thead>
            <tbody>
              <% summary.top_pages.each do |path, views| %>
                <tr>
                  <td class="text-break"><%= link_to path, "#{link_base}#{path}", class: "text-decoration-none" %></td>
                  <td class="text-end"><%= number_with_delimiter(views) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-muted small mb-0">No page views yet.</p>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-6 mb-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body">
        <h2 class="h6 fw-semibold mb-3">Where visits came from, last 30 days</h2>
        <% if summary.top_referrers.any? %>
          <table class="table table-sm small mb-0 visits-table">
            <thead>
              <tr>
                <th scope="col">Site</th>
                <th scope="col" class="text-end">Visits</th>
              </tr>
            </thead>
            <tbody>
              <% summary.top_referrers.each do |host, visits| %>
                <tr>
                  <td class="text-break"><%= host %></td>
                  <td class="text-end"><%= number_with_delimiter(visits) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-muted small mb-0">No visits from other sites yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
