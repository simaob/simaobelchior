<%# Visit stats for one PageView::Summary. Locals: visits, title, id, and link_base,
    which goes before each page path to link to it (blank for pages on this site).
    A visit is one person on one day, so visits over a range are the sum of each day's %>
<% stats = [
     [ "Today", visits.days.last.visits ],
     [ "Last 7 days", visits.days.last(7).sum(&:visits) ],
     [ "Last 30 days", visits.days.sum(&:visits) ],
     [ "Page views, 30 days", visits.days.sum(&:views) ]
   ] %>
<% ceiling = chart_ceiling(visits.days.map(&:visits).max) %>

<section id="<%= id %>" aria-labelledby="<%= id %>-title">
  <h2 class="h5 fw-semibold mb-3" id="<%= id %>-title"><%= title %></h2>
  <div class="row">
    <% stats.each do |label, value| %>
      <div class="col-6 col-md-3 mb-3">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <p class="text-muted text-uppercase small fw-semibold mb-2"><%= label %></p>
            <p class="h2 mb-0"><%= number_with_delimiter(value) %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <h3 class="h6 fw-semibold mb-1">Visits per day</h3>
      <p class="small text-muted mb-4">Last 30 days. A visit is one person on one day, not counting bots or you while logged in.</p>

      <div class="visits-chart">
        <div class="visits-chart__axis" aria-hidden="true">
          <span><%= number_with_delimiter(ceiling) %></span>
          <span>0</span>
        </div>
        <ol class="visits-chart__plot" aria-label="<%= title %> per day, last 30 days">
          <% visits.days.each do |day| %>
            <li class="visits-chart__day" tabindex="0" aria-label="<%= day.day.strftime("%-d %b") %>: <%= pluralize(day.visits, "visit") %>">
              <span class="visits-chart__bar" style="height: <%= bar_height(day.visits, ceiling) %>">
                <span class="visits-chart__tip" aria-hidden="true">
                  <strong><%= pluralize(number_with_delimiter(day.visits), "visit") %></strong>
                  <%= day.day.strftime("%a %-d %b") %>
                </span>
              </span>
            </li>
          <% end %>
        </ol>
        <div class="visits-chart__dates" aria-hidden="true">
          <span><%= visits.days.first.day.strftime("%-d %b") %></span>
          <span>Today</span>
        </div>
      </div>

      <details class="mt-4">
        <summary class="small">Show as a table</summary>
        <table class="table table-sm small mt-2 mb-0 visits-table">
          <thead>
            <tr>
              <th scope="col">Day</th>
              <th scope="col" class="text-end">Visits</th>
              <th scope="col" class="text-end">Page views</th>
            </tr>
          </thead>
          <tbody>
            <% visits.days.reverse_each do |day| %>
              <tr>
                <td><%= day.day.strftime("%a %-d %b") %></td>
                <td class="text-end"><%= number_with_delimiter(day.visits) %></td>
                <td class="text-end"><%= number_with_delimiter(day.views) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </details>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h3 class="h6 fw-semibold mb-3">Top pages, last 30 days</h3>
          <% if visits.top_pages.any? %>
            <table class="table table-sm small mb-0 visits-table">
              <thead>
                <tr>
                  <th scope="col">Page</th>
                  <th scope="col" class="text-end">Page views</th>
                </tr>
              </thead>
              <tbody>
                <% visits.top_pages.each do |path, views| %>
                  <tr>
                    <td class="text-break"><%= link_to path, "#{link_base}#{path}", class: "text-decoration-none" %></td>
                    <td class="text-end"><%= number_with_delimiter(views) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted small mb-0">No page views yet.</p>
          <% end %>
        </div>
      </div>
    </div>
    <div class="col-md-6 mb-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body">
          <h3 class="h6 fw-semibold mb-3">Where visits came from, last 30 days</h3>
          <% if visits.top_referrers.any? %>
            <table class="table table-sm small mb-0 visits-table">
              <thead>
                <tr>
                  <th scope="col">Site</th>
                  <th scope="col" class="text-end">Visits</th>
                </tr>
              </thead>
              <tbody>
                <% visits.top_referrers.each do |host, visits| %>
                  <tr>
                    <td class="text-break"><%= host %></td>
                    <td class="text-end"><%= number_with_delimiter(visits) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-muted small mb-0">No visits from other sites yet.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
